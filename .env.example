# LocalLink AI - Environment Configuration Example
# Set your backend REST API base URL
VITE_API_URL=http://localhost:5000/api

# Map provider: 'osm' (OpenStreetMap - free, no key needed), 'mapbox', or 'google'
VITE_MAP_PROVIDER=osm

# Optional: Mapbox access token if using Mapbox tiles
VITE_MAPBOX_TOKEN=

# Optional: Google Maps API key if using Google Maps JS API
VITE_GOOGLE_MAPS_API_KEY=
