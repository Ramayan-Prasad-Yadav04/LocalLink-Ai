# FloodWatch AI – Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (SQLite by default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./backend/app/database/floodwatch.db

# Security & Authentication
SECRET_KEY=floodwatch-ai-super-secret-key-sih-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hydrological Model Default Thresholds
DEFAULT_DANGER_THRESHOLD_METERS=3.50
DEFAULT_WARNING_THRESHOLD_METERS=2.80
DEFAULT_CLOUDBURST_RAIN_MM_HR=100.0
DEFAULT_MONTE_CARLO_SAMPLES=1000

# Automated Emergency Alert Dispatcher (SMTP)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_SENDER_EMAIL=alerts@floodwatch.ai

# Initial Simulation Mode (normal | warning | extreme)
DEFAULT_SIMULATION_SCENARIO=normal
